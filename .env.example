# 复制为 .env 后按需填写,docker compose 会自动加载
# cp .env.example .env

HTTP_PORT=80
TZ=Asia/Shanghai

# 构建/运行使用的镜像名(save/load 或 push/pull 都用这两项)
BACKEND_IMAGE=oops-calendar-backend:latest
WEB_IMAGE=oops-calendar-web:latest

# 构建时基础镜像前缀(国内默认 DaoCloud;海外改为 docker.io)
DOCKER_HUB=docker.m.daocloud.io
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com

# 真实财报数据(可选,都不填则用内置演示数据)
FINNHUB_API_KEY=
FMP_API_KEY=

# 浏览器跨域来源;同机 Nginx 反代同域访问通常无需改
# 若前端经其它域名访问,写成逗号分隔:https://calendar.example.com
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
